# starknet RPC endpoint
RPC_URL=https://starknet-rpc.publicnode.com

# deployed Iceberg contract
ICEBERG_ADDRESS=

# keeper account — omit both and run with --dry-run to skip signing entirely
KEEPER_ADDRESS=
KEEPER_PRIVATE_KEY=

# token addresses Iceberg was deployed with (in_token / out_token)
IN_TOKEN=
OUT_TOKEN=

# slippage haircut applied to the AVNU quote, in basis points (100 = 1%)
SLIPPAGE_BPS=100

# max random delay in seconds before calling execute_batch, so batch timing
# isn't perfectly predictable
JITTER_MAX_S=120

# how often to check for a matured interval, in seconds
POLL_INTERVAL_S=60

AVNU_BASE=https://starknet.api.avnu.fi

# "avnu" quotes real tokens for min_out (required on mainnet).
# "none" sends min_out=0 — only for devnet/mock tokens AVNU can't price.
# Never set this to "none" against a mainnet deployment.
MIN_OUT_SOURCE=avnu

# --- deploy-mainnet.mjs only (dry-run by default; needs --yes to broadcast) ---

# funded mainnet account that pays gas and signs the deploy
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# how often execute_batch can run, in seconds. PERMANENT once deployed —
# no setter exists. 300 = 5 minutes (short, for testing); 3600 = hourly.
INTERVAL_SECONDS=300
